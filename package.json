    "android:live": "npx cap run android -l --external"
  },
  "devDependencies": {
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0"
  }
}
